# CampusAI backend configuration
# Copy this file to .env and adjust as needed.

# SQLite is used by default — zero setup. For Postgres use e.g.
# DATABASE_URL=postgresql://user:password@host:5432/campusai
DATABASE_URL=sqlite:///./campus_ai.db

# Used to build full referral links returned by the API (POST /api/register)
FRONTEND_URL=http://localhost:5173

# Comma separated list of allowed CORS origins, or "*" for the demo
CORS_ORIGINS=*
