# Leave empty for local dev — Vite proxies /api to the backend automatically
# (see vite.config.ts, which uses VITE_BACKEND_URL below for that proxy only).
#
# For production, if the frontend (e.g. Vercel/Netlify) and backend
# (e.g. Render/Railway) are deployed separately, set this to your backend's
# public URL so the built app calls it directly:
# VITE_API_BASE_URL=https://campusai-backend.onrender.com
VITE_API_BASE_URL=

# Only used by vite.config.ts during `npm run dev` to proxy /api calls.
VITE_BACKEND_URL=http://localhost:8000
